{
  "name": "newepibot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"next dev\" \"tsx watch src/bot/index.ts\"",
    "dev:web": "next dev",
    "dev:bot": "tsx watch src/bot/index.ts",
    "dev:local": "concurrently -k \"next dev\" \"tsx src/bot/index.ts\"",
    "build": "prisma generate && next build",
    "start": "concurrently -k \"next start\" \"node ./src/bot/index.js\"",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.13.0",
    "@types/turndown": "^5.0.6",
    "concurrently": "^9.1.2",
    "discord.js": "^14.21.0",
    "dotenv": "^16.1.4",
    "fast-xml-parser": "^4.5.3",
    "next": "^15.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "turndown": "^7.2.4",
    "zlib-sync": "^0.1.10",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "prisma": "^6.13.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  }
}
